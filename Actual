local function ORWW_fake_script() -- Frame_6.LocalScript 
	local script = Instance.new('LocalScript', Frame_6)

	local toggleFrame = script.Parent
	local colorFrame = toggleFrame:WaitForChild("colourframe")
	local toggleKnob = colorFrame:WaitForChild("ImageButton")
	
	local Players = game:GetService("Players")
	local TweenService = game:GetService("TweenService")
	
	local player = Players.LocalPlayer
	local isOn = false
	
	local knobSize = toggleKnob.Size.X.Offset
	
	local espObjects = {}
	
	-- Create ESP for a player
	local function createESP(targetPlayer)
		if targetPlayer == player then
			return
		end
	
		local character = targetPlayer.Character
		if not character then
			return
		end
	
		-- Remove old ESP if it exists
		if espObjects[targetPlayer] then
			for _, object in ipairs(espObjects[targetPlayer]) do
				if object and object.Parent then
					object:Destroy()
				end
			end
		end
	
		espObjects[targetPlayer] = {}
	
		-- Outline
		local highlight = Instance.new("Highlight")
		highlight.Name = "PlayerESP"
		highlight.FillColor = Color3.fromRGB(255, 0, 0)
		highlight.FillTransparency = 0.75
		highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Adornee = character
		highlight.Parent = character
	
		table.insert(espObjects[targetPlayer], highlight)
	
		-- Username
		local head = character:FindFirstChild("Head")
	
		if head then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "UsernameESP"
			billboard.Size = UDim2.new(0, 200, 0, 50)
			billboard.StudsOffset = Vector3.new(0, 3, 0)
			billboard.AlwaysOnTop = true
			billboard.MaxDistance = 1000
			billboard.Adornee = head
			billboard.Parent = head
	
			local username = Instance.new("TextLabel")
			username.Size = UDim2.new(1, 0, 1, 0)
			username.BackgroundTransparency = 1
			username.Text = targetPlayer.Name
			username.TextColor3 = Color3.fromRGB(255, 255, 255)
			username.TextStrokeTransparency = 0
			username.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			username.TextScaled = true
			username.Font = Enum.Font.GothamBold
			username.Parent = billboard
	
			table.insert(espObjects[targetPlayer], billboard)
		end
	end
	
	-- Remove ESP
	local function removeESP(targetPlayer)
		if espObjects[targetPlayer] then
			for _, object in ipairs(espObjects[targetPlayer]) do
				if object and object.Parent then
					object:Destroy()
				end
			end
	
			espObjects[targetPlayer] = nil
		end
	end
	
	-- Create ESP for everyone
	local function enableESP()
		for _, targetPlayer in ipairs(Players:GetPlayers()) do
			if targetPlayer ~= player then
				createESP(targetPlayer)
			end
		end
	end
	
	-- Remove all ESP
	local function disableESP()
		for targetPlayer, _ in pairs(espObjects) do
			removeESP(targetPlayer)
		end
	end
	
	-- Toggle
	toggleKnob.MouseButton1Click:Connect(function()
		isOn = not isOn
	
		local targetPosition
	
		if isOn then
			-- ON
			colorFrame.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
			toggleKnob.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
	
			targetPosition = UDim2.new(1, -knobSize, 0, 0)
	
			enableESP()
		else
			-- OFF
			colorFrame.BackgroundColor3 = Color3.fromRGB(83, 0, 0)
			toggleKnob.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	
			targetPosition = UDim2.new(0, 0, 0, 0)
	
			disableESP()
		end
	
		local tween = TweenService:Create(
			toggleKnob,
			TweenInfo.new(
				0.25,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				Position = targetPosition
			}
		)
	
		tween:Play()
	end)
	
	-- New players
	Players.PlayerAdded:Connect(function(targetPlayer)
		targetPlayer.CharacterAdded:Connect(function()
			if isOn then
				task.wait(0.5)
				createESP(targetPlayer)
			end
		end)
	end)
	
	-- Existing players respawning
	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player then
			targetPlayer.CharacterAdded:Connect(function()
				if isOn then
					task.wait(0.5)
					createESP(targetPlayer)
				end
			end)
		end
	end
	
	-- Player leaves
	Players.PlayerRemoving:Connect(function(targetPlayer)
		removeESP(targetPlayer)
	end)
end
